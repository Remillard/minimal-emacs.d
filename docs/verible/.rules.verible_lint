# Verible lint rules.  Copy to ~/.rules.verible_lint or a project root; found by
# --rules_config_search, searching upward from the source file.
# Constants (localparam): C_ prefix, ALL_CAPS.
parameter-name-style=localparam_style:;localparam_style_regex:C_[A-Z0-9_]+
# Generate block labels: ALL_CAPS (default expects g_/gen_ prefix).
generate-label-prefix=style_regex:[A-Z][A-Z0-9_]*
# Ports: _i / _o / _io direction suffix (active-low as *_n_i, *_n_o).
+port-name-suffix
